{
  "compilerOptions": {
    "target": "ESNext",
    "module": "preserve",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "rootDir": "./src",
    "outDir": "./dist",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"]
    },
  },
  "exclude": ["node_modules", "prisma7.config.ts"]
}
